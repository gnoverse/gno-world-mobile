{
  "name": "gno-world",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@gnolang/gnonative": "^5.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "bech32": "^2.0.0",
    "expo": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@connectrpc/connect-node": "^2.2.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "patch-package": "^8.0.1",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "e2e": "bash scripts/e2e.sh",
    "gnodev": "bash scripts/gnodev.sh",
    "devchain:update": "node scripts/devchain-update.mjs",
    "fake-offchain": "node --experimental-strip-types --no-warnings scripts/fake-offchain/main.mjs",
    "e2e:chat": "jest -c jest.e2e.config.js --runInBand e2e/fake-offchain e2e/chat",
    "e2e:pair": "jest -c jest.e2e.config.js --runInBand e2e/pair",
    "e2e:rooms": "jest -c jest.e2e.config.js --runInBand e2e/rooms",
    "fake-browser": "node --experimental-strip-types --no-warnings scripts/fake-offchain/browser.mjs",
    "demo": "npm --prefix demo run all",
    "demo:build": "bash demo/tools/build.sh",
    "demo:capture": "npm --prefix demo run capture --",
    "demo:voice": "npm --prefix demo run voice",
    "demo:render": "npm --prefix demo run render",
    "demo:check": "npm --prefix demo run check",
    "demo:stage": "npm --prefix demo run stage"
  },
  "private": true,
  "license": "Apache-2.0",
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/\\.e2e/",
      "/demo/",
      "/prototypes/"
    ]
  }
}
